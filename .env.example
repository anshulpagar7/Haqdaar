# Both are FREE tiers. The app runs without them in MOCK mode.
# Google AI Studio  ->  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (Whisper speech-to-text)  ->  https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
GROQ_ASR_MODEL=whisper-large-v3-turbo
PORT=8787

# Set this to enable the admin write endpoints (scheme upsert / verify / retire)
ADMIN_KEY=
# Where SQLite lives
DATABASE_FILE=data/haqdaar.db
