{
  "name": "haqdaar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Don't make citizens search for schemes. Make the schemes search the citizen.",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx server/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('data/haqdaar.db',{force:true});require('fs').rmSync('data/haqdaar.db-wal',{force:true});require('fs').rmSync('data/haqdaar.db-shm',{force:true})\" && npm run db:seed",
    "setup": "npm install && npm run db:seed",
    "doctor": "tsx scripts/doctor.ts",
    "start": "tsx server/index.ts",
    "serve": "npm run build && tsx server/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
